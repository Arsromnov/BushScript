import "std/math.js"
import "std/str-utils.js"

let random = math.randomInt 1 100
let user = readLine "your num>"


if user == random
    log "win!" user "==" random
    let more = readLine "try hard mode? (y/n) >"
    let more = toLower more
    log more
    if more == y 
        let randomH = math.randomInt 1 100
        let userH = readLine "your num>"

        if userH == randomH
            log "<:
        else 
            if user > random 
                log "<"
            end
            if user < random
                log ">"
            end  
            
            goto 12
        end
    end
else

    if user > random 
        log "<"
    end
    if user < random
        log ">"
    end  

    goto 2
end    

    



